# Snowflake
SNOWFLAKE_ACCOUNT=...
SNOWFLAKE_USER=...
SNOWFLAKE_PASSWORD=...
SNOWFLAKE_DATABASE=...
SNOWFLAKE_SCHEMA=...
SNOWFLAKE_WAREHOUSE=...
SNOWFLAKE_ROLE=...

# Qdrant Vector Store
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Data storage
RAW_DATA_DIR=./data/raw
PARSED_ARTIFACTS_DIR=./artifacts/parsed

# Layout-aware PDF ingestion
ENABLE_LAYOUT_AWARE_PDF=true
STRICT_LAYOUT_AWARE_PDF_FAILURE=false
ENABLE_OCR_FALLBACK=true
ENABLE_MULTIPAGE_TABLE_MERGE=true
PDF_LAYOUT_PARSER_VERSION=3.0.0
BODY_TEXT_CHUNK_MAX_TOKENS=600
BODY_TEXT_CHUNK_OVERLAP_TOKENS=40
TABLE_CHUNK_ROW_THRESHOLD=6
ENABLE_PYMUPDF_LAYOUT=true
ENABLE_PDF_REPAIR_PREPASS=true
SUPPRESS_MUPDF_STDERR=true
ENABLE_LLM_ARTIFACT_ENRICHMENT=true
LLM_ARTIFACT_ENRICHMENT_MAX_PAGES=3
ENABLE_MULTIMODAL_CAPTIONING=true
LLM_CAPTION_MAX_PAGES=3
LLM_CAPTION_MAX_ARTIFACTS_PER_PAGE=3
LLM_CAPTION_TIMEOUT_SECONDS=25
LLM_SCREENSHOT_TIMEOUT_SECONDS=45
LLM_SCREENSHOT_MAX_WORKERS=2
LLM_SCREENSHOT_RETRIES=2
REASONING_MAX_OUTPUT_TOKENS=700

# Non-layout parser configuration (semantic splitter)
SEMANTIC_SPLITTER_BREAKPOINT_PERCENTILE=95
SEMANTIC_SPLITTER_BUFFER_SIZE=1

# OpenAI / LlamaIndex
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4o-mini
QUERY_EXPANSION_MODEL=gpt-4o-mini
OPENAI_USE_RESPONSES=false
TOKEN_BUDGET_ENCODING=o200k_base
CHAT_SUMMARY_MAX_OUTPUT_TOKENS=300

# Optional semantic cross-encoder reranking after metadata reranking.
# Requires sentence-transformers/torch in the runtime image.
ENABLE_CROSS_ENCODER_RERANKING=true
# Optional. When unset, CROSS_ENCODER_RERANK_FALLBACK_MODEL is used.
HF_API_TOKEN=
CROSS_ENCODER_RERANK_MODEL=BAAI/bge-reranker-base
CROSS_ENCODER_RERANK_FALLBACK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
CROSS_ENCODER_RERANK_DEVICE=
CROSS_ENCODER_RERANK_TRUST_REMOTE_CODE=false

EMBEDDING_MODEL=text-embedding-3-large
# Leave empty to use the model default dimensionality.
EMBEDDING_OUTPUT_DIMENSION=
VECTOR_DIMENSIONS=3072
